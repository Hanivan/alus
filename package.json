{
	"name": "alus-svelte",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "concurrently --kill-others \"pnpm --filter alus-ui dev\" \"pnpm dev:showcase\" \"pnpm --filter alus-ui-mcp run dev:build\"",
		"dev:showcase": "vite dev",
		"predev:showcase": "wrangler types",
		"prebuild": "wrangler types",
		"build": "vite build",
		"deploy": "pnpm build && pnpm exec wrangler deploy",
		"preview": "wrangler dev",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest",
		"test:unit": "vitest"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@alus-ui/mcp-server": "workspace:*",
		"@internationalized/date": "^3.12.4",
		"@tmcp/transport-http": "latest",
		"alus-ui": "workspace:*",
		"phosphor-svelte": "^3.1.1",
		"runed": "^0.38.0",
		"tmcp": "latest"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-cloudflare": "^8.0.2",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.5",
		"@types/node": "^26",
		"@vitest/browser-playwright": "^5.1.0",
		"concurrently": "^10.0.7",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"playwright": "^1.65.1",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.5",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.72.2",
		"vite": "^8.3.8",
		"vitest": "^5.1.0",
		"vitest-browser-svelte": "^3.1.0",
		"wrangler": "^4.162.0"
	}
}
