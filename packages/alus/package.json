{
	"name": "alus-ui",
	"version": "0.3.0",
	"description": "Unstyled, accessible Svelte 5 components with full keyboard navigation and WCAG 2.1 AA compliance",
	"license": "MIT",
	"type": "module",
	"author": {
		"name": "Hanivan Rizky",
		"email": "hanivan20@gmail.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Hanivan/alus.git"
	},
	"homepage": "https://github.com/Hanivan/alus#readme",
	"bugs": {
		"url": "https://github.com/Hanivan/alus/issues"
	},
	"keywords": [
		"svelte",
		"svelte5",
		"svelte-components",
		"ui-components",
		"accessible",
		"accessibility",
		"a11y",
		"wcag",
		"wcag-2.1",
		"keyboard-navigation",
		"unstyled",
		"components",
		"tailwindcss",
		"runes",
		"typescript"
	],
	"files": [
		"dist",
		"!dist/**/__tests__",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		}
	},
	"scripts": {
		"dev": "svelte-kit sync && svelte-package --watch",
		"build": "svelte-kit sync && svelte-package && publint",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "npm run build",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "publint",
		"test": "vitest run",
		"prepublishOnly": "npm run build && npm run test",
		"release": "release-it",
		"release:dry": "release-it --dry-run",
		"release:minor": "release-it minor",
		"release:patch": "release-it patch",
		"release:major": "release-it major"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"peerDependencies": {
		"@floating-ui/dom": "^1.7.6",
		"svelte": "^5.0.0"
	},
	"dependencies": {
		"@floating-ui/dom": "^1.8.0",
		"@internationalized/date": "^3.12.4",
		"runed": "^0.38.0"
	},
	"devDependencies": {
		"@release-it/conventional-changelog": "^12.0.2",
		"@sveltejs/adapter-auto": "^8.0.1",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/package": "^3.0.2",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@vitest/browser-playwright": "^5.1.0",
		"publint": "^0.3.25",
		"release-it": "^21.1.2",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"typescript": "^6.0.2",
		"vite": "^8.3.8",
		"vitest": "^5.1.0",
		"vitest-browser-svelte": "^3.1.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=18.0.0",
		"pnpm": ">=8.0.0"
	}
}
